NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prisma runtime pool (transaction mode). Percent-encode password special characters.
DATABASE_URL="postgresql://postgres.ilafinmwpsmhldyicoyl:YOUR_PERCENT_ENCODED_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI / migrations (session mode).
DIRECT_URL="postgresql://postgres.ilafinmwpsmhldyicoyl:YOUR_PERCENT_ENCODED_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Used by @supabase/server. Keep the secret key server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Server only. Never prefix this with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional WhatsApp notifications. Configure with Meta's approved templates.
WHATSAPP_ACCESS_TOKEN=your-server-only-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-whatsapp-phone-number-id
WHATSAPP_GRAPH_API_VERSION=vXX.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_OTP_TEMPLATE_NAME=your-approved-authentication-copy-code-template
WHATSAPP_ACTIVITY_TEMPLATE_NAME=your-approved-utility-activity-template
WHATSAPP_WORKER_SECRET=generate-a-long-random-secret-for-the-dispatch-endpoint
